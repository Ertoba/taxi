<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>

	<!-- ✅ Google API Key (used by Firebase / Google Maps SDK) -->

	<!-- ✅ Improves rendering performance on iPhones -->
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>

	<!-- ✅ App language/region settings -->
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>

	<!-- ✅ App display name on home screen -->
	<key>CFBundleDisplayName</key>
	<string>MILI TAXI</string>

	<!-- ✅ Executable file -->
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>

	<!-- ✅ Bundle identifier (unique app ID) -->
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>

	<!-- ✅ Info.plist version -->
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>

	<!-- ✅ App name -->
	<key>CFBundleName</key>
	<string>MILI TAXI</string>

	<!-- ✅ App type (always APPL for iOS apps) -->
	<key>CFBundlePackageType</key>
	<string>APPL</string>

	<!-- ✅ App version (e.g. 1.0.0) -->
	<key>CFBundleShortVersionString</key>
	<string>$(FLUTTER_BUILD_NAME)</string>

	<!-- ✅ Signature (???? is default placeholder) -->
	<key>CFBundleSignature</key>
	<string>????</string>

	<!-- ✅ URL Schemes (used for Google Sign-In / OAuth) -->

	<!-- ✅ Build number (internal version code) -->
	<key>CFBundleVersion</key>
	<string>$(FLUTTER_BUILD_NUMBER)</string>

	<!-- ✅ Google Maps API Key (must be set correctly) -->
	<key>GMSApiKey</key>
	<string>$(GOOGLE_MAPS_API_KEY)</string>

	<!-- ✅ Firebase App ID -->

	<!-- ✅ Required for all iOS apps -->
	<key>LSRequiresIPhoneOS</key>
	<true/>

	<!-- ✅ Permissions (iOS Privacy settings) -->
	<key>NSCameraUsageDescription</key>
	<string>Mili Taxi-ს კამერაზე წვდომა სჭირდება ფოტოების გადასაღებად და ჩატში ან პროფილში ასატვირთად.</string>

	<key>NSLocationAlwaysAndWhenInUseUsageDescription</key>
	<string>Mili Taxi თქვენს მდებარეობას იყენებს ახლომდებარე მძღოლების მოსაძებნად და მგზავრობის მიმდინარეობის საჩვენებლად, მათ შორის ფონურ რეჟიმში.</string>

	<key>NSLocationWhenInUseUsageDescription</key>
	<string>Mili Taxi-ს მდებარეობაზე წვდომა სჭირდება აყვანის ადგილისა და ახლომდებარე მძღოლების განსაზღვრისთვის.</string>

	<key>NSPhotoLibraryUsageDescription</key>
	<string>Mili Taxi-ს ფოტოებზე წვდომა სჭირდება პროფილისა და მხარდაჭერის ჩატის სურათების ასატვირთად.</string>

	<!-- ✅ Allows external keyboards / input -->
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>

	<!-- ✅ Background services -->
	<key>UIBackgroundModes</key>
	<array>
		<string>fetch</string>
		<string>location</string>
		<string>remote-notification</string>
	</array>

	<!-- ✅ Launch screen storyboard -->
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>

	<!-- ✅ Main storyboard (not used in Flutter, but required by iOS) -->
	<key>UIMainStoryboardFile</key>
	<string>Main</string>

	<!-- ✅ Supported orientations (iPhone) -->
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>

	<!-- ✅ Supported orientations (iPad) -->
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>

</dict>
</plist>
